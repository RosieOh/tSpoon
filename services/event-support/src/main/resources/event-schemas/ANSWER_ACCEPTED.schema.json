{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspoon.local/event-schemas/ANSWER_ACCEPTED.schema.json",
  "title": "답변이 채택됐다",
  "description": "qna-service → tspoon.qna.events.",
  "type": "object",
  "required": [
    "answerId",
    "questionId",
    "questionTitle",
    "questionAuthorId",
    "answerAuthorId"
  ],
  "properties": {
    "answerId": {
      "type": "integer",
      "minimum": 1
    },
    "questionId": {
      "type": "integer",
      "minimum": 1
    },
    "questionTitle": {
      "type": "string",
      "minLength": 1
    },
    "questionAuthorId": {
      "type": "integer",
      "minimum": 1
    },
    "answerAuthorId": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
