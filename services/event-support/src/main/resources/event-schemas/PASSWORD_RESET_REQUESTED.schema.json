{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspoon.local/event-schemas/PASSWORD_RESET_REQUESTED.schema.json",
  "title": "비밀번호 재설정 메일 발송 요청",
  "description": "user-service → tspoon.user.events. token 은 메일 링크에만 쓰는 일회용 값이다.",
  "type": "object",
  "required": [
    "userId",
    "email",
    "name",
    "token",
    "expiresAt"
  ],
  "properties": {
    "userId": {
      "type": "integer",
      "minimum": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "token": {
      "type": "string",
      "minLength": 1
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
