{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspoon.local/event-schemas/envelope.schema.json",
  "title": "이벤트 봉투",
  "description": "outbox 릴레이가 Kafka 로 보내는 모든 메시지의 겉모양. payload 의 형식은 eventType 별 스키마가 정한다.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "aggregateType",
    "aggregateId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateType": {
      "type": "string",
      "minLength": 1
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
