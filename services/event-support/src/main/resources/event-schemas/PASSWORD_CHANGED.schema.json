{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tspoon.local/event-schemas/PASSWORD_CHANGED.schema.json",
  "title": "비밀번호가 바뀌었다",
  "description": "user-service → tspoon.user.events. 본인에게 변경 사실을 메일로 알린다.",
  "type": "object",
  "required": [
    "userId",
    "email",
    "name",
    "changedAt"
  ],
  "properties": {
    "userId": {
      "type": "integer",
      "minimum": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "changedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
