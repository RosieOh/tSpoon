# cp .env.example .env 후 값을 바꿔서 사용한다. (.env 는 git 에 올라가지 않는다)
POSTGRES_USER=tspoon
POSTGRES_PASSWORD=tspoon
# 호스트에 이미 PostgreSQL 이 5432 를 쓰고 있으면 다른 포트로 바꾼다
POSTGRES_PORT=5432
REDIS_PORT=6379

# 최소 32바이트 이상. 예) openssl rand -base64 48
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789

# 둘 다 설정하면 관리자가 없을 때 user-service 가 기동하며 관리자 계정을 만든다 (비밀번호 8자 이상)
ADMIN_EMAIL=admin@tspoon.local
ADMIN_PASSWORD=change-me-admin-password

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
